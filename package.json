    "astro": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^6.1.0",
    "rehype-katex": "^6.0.2",
    "rehype-prism-plus": "^1.5.0",
    "rehype-slug": "^5.0.0",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "tailwindcss": "^3.2.2",
