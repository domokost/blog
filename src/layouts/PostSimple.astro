---
import Base from './Base.astro'
import Link from '../components/Link.astro'
import PageTitle from '../components/PageTitle.astro'
import ScrollTopAndComment from '../components/react/ScrollTopAndComment'
import GiscusComments from '../components/react/GiscusComments'
import siteMetadata from '../data/siteMetadata'
import { formatDate } from '../lib/utils'

interface Props {
  title: string
  date: string
  slug: string
  summary?: string
  prev?: { path: string; title: string }
  next?: { path: string; title: string }
}

const { title, date, slug, summary, prev, next } = Astro.props
---

<Base title={title} description={summary} ogType="article">
  <ScrollTopAndComment client:visible />
  <article>
    <div>
      <header>
        <div class="space-y-1 border-b border-gray-200 pb-10 text-center dark:border-gray-700">
          <dl>
            <div>
              <dt class="sr-only">Published on</dt>
              <dd class="text-base font-medium leading-6 text-gray-500 dark:text-gray-400">
                <time datetime={date}>{formatDate(date, siteMetadata.locale)}</time>
              </dd>
            </div>
          </dl>
          <div>
            <PageTitle>{title}</PageTitle>
          </div>
        </div>
      </header>
      <div
        class="grid-rows-[auto_1fr] divide-y divide-gray-200 pb-8 dark:divide-gray-700 xl:divide-y-0"
      >
        <div
          class="divide-y divide-gray-200 dark:divide-gray-700 xl:col-span-3 xl:row-span-2 xl:pb-0"
        >
          <div class="prose max-w-none pt-10 pb-8 dark:prose-dark">
            <slot />
          </div>
        </div>
        {
          siteMetadata.comments && (
            <GiscusComments
              client:visible
              slug={slug}
              config={siteMetadata.comments.giscusConfig}
            />
          )
        }
        <footer>
          <div
            class="flex flex-col text-sm font-medium sm:flex-row sm:justify-between sm:text-base"
          >
            {
              prev && (
                <div class="pt-4 xl:pt-8">
                  <Link
                    href={`/${prev.path}`}
                    class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                    aria-label={`Previous post: ${prev.title}`}
                  >
                    &larr; {prev.title}
                  </Link>
                </div>
              )
            }
            {
              next && (
                <div class="pt-4 xl:pt-8">
                  <Link
                    href={`/${next.path}`}
                    class="text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                    aria-label={`Next post: ${next.title}`}
                  >
                    {next.title} &rarr;
                  </Link>
                </div>
              )
            }
          </div>
        </footer>
      </div>
    </div>
  </article>
</Base>
