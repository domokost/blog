---
interface Props {
  href: string
  class?: string
  'aria-label'?: string
  rel?: string
  [key: string]: any
}

const { href, class: className, ...rest } = Astro.props

const isInternalLink = href && href.startsWith('/')
const isAnchorLink = href && href.startsWith('#')
---

{
  isInternalLink ? (
    <a href={href} class={className} {...rest}>
      <slot />
    </a>
  ) : isAnchorLink ? (
    <a href={href} class={className} {...rest}>
      <slot />
    </a>
  ) : (
    <a target="_blank" rel="noopener noreferrer" href={href} class={className} {...rest}>
      <slot />
    </a>
  )
}
